{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlifemodel.com/schema/olm-0.1.json",
  "title": "OpenLifeModel model file (OLM 0.1)",
  "description": "Structural schema for .olm files. Semantic rules that JSON Schema cannot express (equal table lengths, prevalences summing to 1, non-overlapping bands) are listed in OLM-SPEC.md and must also be checked by implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "olm",
    "id",
    "name",
    "version",
    "status",
    "license",
    "authors",
    "description",
    "sources",
    "baseline"
  ],
  "properties": {
    "olm": {
      "const": "0.1"
    },
    "id": {
      "description": "Stable identifier: lowercase letters, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "description": "Semantic version of this model.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "description": "illustrative: demonstrates the format; numbers are not evidence-based. experimental: evidence-based but not validated. published: reproduces an authoritative published source (a peer-reviewed paper or official statistics).",
      "enum": [
        "illustrative",
        "experimental",
        "published"
      ]
    },
    "license": {
      "description": "SPDX licence identifier for this model file, or LicenseRef-<name> for custom terms.",
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "description": "Who the model is intended for, in plain language.",
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "citation"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.\\d{4,9}/\\S+$"
          },
          "url": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "start_age",
        "qx"
      ],
      "properties": {
        "type": {
          "const": "period-life-table"
        },
        "source": {
          "$ref": "#/$defs/localId"
        },
        "start_age": {
          "type": "integer",
          "minimum": 0
        },
        "qx": {
          "description": "Probability of dying between exact age x and x+1, one entry per age from start_age. Keys are sexes from the PersonProfile.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "male": {
              "$ref": "#/$defs/qxTable"
            },
            "female": {
              "$ref": "#/$defs/qxTable"
            }
          }
        }
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "normalization",
        "factors"
      ],
      "properties": {
        "method": {
          "const": "proportional-hazards"
        },
        "normalization": {
          "description": "population-average: hazard ratios are divided by their prevalence-weighted mean so that an average person reproduces the baseline. none: the baseline already describes the reference level.",
          "enum": [
            "population-average",
            "none"
          ]
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/factor"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "profile",
          "expect"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "profile": {
            "type": "object"
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "remaining_life_expectancy": {
                "$ref": "#/$defs/expectation"
              },
              "median_age_at_death": {
                "$ref": "#/$defs/expectation"
              },
              "survival_to_80": {
                "$ref": "#/$defs/expectation"
              },
              "survival_to_90": {
                "$ref": "#/$defs/expectation"
              },
              "survival_to_100": {
                "$ref": "#/$defs/expectation"
              },
              "combined_hazard_ratio": {
                "$ref": "#/$defs/expectation"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
    },
    "qxTable": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "exclusiveMaximum": 1
      }
    },
    "hazardRatio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "prevalence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "tolerance"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "factor": {
      "type": "object",
      "required": [
        "id",
        "label",
        "input",
        "type",
        "missing"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "description": "PersonProfile field this factor reads.",
          "enum": [
            "smoking_status",
            "bmi",
            "systolic_bp",
            "mvpa_minutes_per_week",
            "alcohol_drinks_per_week"
          ]
        },
        "type": {
          "enum": [
            "categorical",
            "banded"
          ]
        },
        "missing": {
          "description": "neutral: a missing input contributes a normalized hazard ratio of 1. required: calculation fails without it.",
          "enum": [
            "neutral",
            "required"
          ]
        },
        "source": {
          "$ref": "#/$defs/localId"
        },
        "notes": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "hazard_ratio"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "hazard_ratio": {
                "$ref": "#/$defs/hazardRatio"
              },
              "prevalence": {
                "$ref": "#/$defs/prevalence"
              }
            }
          }
        },
        "bands": {
          "description": "Ranges [min, max). Omit min for the lowest band and max for the highest.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hazard_ratio"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "hazard_ratio": {
                "$ref": "#/$defs/hazardRatio"
              },
              "prevalence": {
                "$ref": "#/$defs/prevalence"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "categorical"
            }
          },
          "required": [
            "levels"
          ],
          "not": {
            "required": [
              "bands"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "banded"
            }
          },
          "required": [
            "bands"
          ],
          "not": {
            "required": [
              "levels"
            ]
          }
        }
      ]
    }
  }
}
